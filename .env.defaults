# PostgreSQL Configuration
POSTGRES_USER=mmuser
POSTGRES_DB=mattermost
# POSTGRES_PASSWORD provided by env

# Mattermost Configuration
MATTERMOST_IMAGE=mattermost/mattermost-team-edition:latest
MATTERMOST_PORT=8065
MM_SERVICESETTINGS_SITEURL=http://localhost:8065

# Mattermost Initial Admin & Team
MM_ADMIN_USERNAME=admin
MM_ADMIN_EMAIL=admin@example.com
MM_TEAM_NAME=molt-team
MM_TEAM_DISPLAY_NAME="Moltbot Team"
# MM_ADMIN_PASSWORD provided by env

# Moltbot Configuration
MOLTBOT_IMAGE=node:22-bookworm
MOLTBOT_VERSION=latest
# ANTHROPIC_API_KEY provided by env

# ngrok Configuration (Optional)
# NGROK_AUTHTOKEN provided by env
# NGROK_DOMAIN provided by env
